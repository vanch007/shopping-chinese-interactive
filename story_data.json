  "topics": [
    {
      "zh": "在越南，你平时喜欢逛超市还是去传统市场？为什么？",
      "py": "zài yuè nán ， nǐ píng shí xǐ huān guàng chāo shì hái shì qù chuán tǒng shì chǎng ？ wèi shén me ？",
      "vn": "Ở Việt Nam, bạn thường thích đi siêu thị hay đi chợ truyền thống? Vì sao?",
      "audioKey": "topic_0",
      "en": "In Vietnam, do you usually prefer shopping at supermarkets or traditional markets? Why?"
    },
    {
      "zh": "买衣服时，你觉得牌子重要，还是款式和料子更重要？",
      "py": "mǎi yī fú shí ， nǐ jué de pái zi zhòng yào ， hái shì kuǎn shì hé liào zi gèng zhòng yào ？",
      "vn": "Khi mua quần áo, bạn thấy thương hiệu quan trọng, hay kiểu dáng và chất vải quan trọng hơn?",
      "audioKey": "topic_1",
      "en": "When buying clothes, do you think brand is more important, or style and fabric?"
    },
    {
      "zh": "我们周末先去商场，然后再逛夜市，怎么样？",
      "py": "wǒ men zhōu mò xiān qù shāng chǎng ， rán hòu zài guàng yè shì ， zěn me yàng ？",
      "vn": "Cuối tuần chúng mình đến trung tâm thương mại trước rồi dạo chợ đêm, thế nào?",
      "audioKey": "topic_2",
      "en": "How about we go to the mall first this weekend, and then visit the night market?"
    }
  ],
